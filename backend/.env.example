# Server Configuration
PORT=5001
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
# If left empty in development/testing, an in-memory MongoDB instance will be used automatically
MONGODB_URI=mongodb://localhost:27017/procurepilot

# JWT Secrets
JWT_ACCESS_SECRET=procurepilot-super-secret-access-token-key-min32chars
JWT_REFRESH_SECRET=procurepilot-super-secret-refresh-token-key-min32chars
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Gemini AI (Optional in dev: fallback parser will activate if missing)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Currency & Demo Rates
DEMO_INR_PER_USD=88

# PayPal Sandbox Configuration
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
