{
  "info": {
    "_postman_id": "c1f6d3a9-83bc-42b7-a3a8-4c126937e291",
    "name": "ProcurePilot AI API",
    "description": "Complete Postman collection for ProcurePilot AI backend API covering authentication, product catalog, autonomous procurement, purchase orders, PayPal payments, webhooks, and analytics.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "",
      "type": "string"
    },
    {
      "key": "requestId",
      "value": "",
      "type": "string"
    },
    {
      "key": "paypalOrderId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. System",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register Store Owner",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ramesh Patel\",\n  \"email\": \"ramesh@patelstore.com\",\n  \"password\": \"Password@123\",\n  \"businessName\": \"Patel Supermarket\",\n  \"businessType\": \"supermarket\",\n  \"city\": \"Mumbai\",\n  \"monthlyBudgetPaise\": 15000000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login (Demo Account)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data && res.data.accessToken) {",
                  "    pm.collectionVariables.set('token', res.data.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@procurepilot.ai\",\n  \"password\": \"Demo@12345\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Get Current Profile (Me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Catalogue",
      "item": [
        {
          "name": "List Products",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/products?q=oil",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [{ "key": "q", "value": "oil" }]
            }
          }
        },
        {
          "name": "List Verified Suppliers",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/suppliers",
              "host": ["{{baseUrl}}"],
              "path": ["suppliers"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Procurement Pipeline",
      "item": [
        {
          "name": "Step 1: Analyze Request",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data && res.data.requestId) {",
                  "    pm.collectionVariables.set('requestId', res.data.requestId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"I need to restock 20 units of cooking oil, 30 packets of rice and 15 units of detergent. Keep the total under ₹15,000. Prioritize reliable suppliers.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/procurement/analyze",
              "host": ["{{baseUrl}}"],
              "path": ["procurement", "analyze"]
            }
          }
        },
        {
          "name": "Step 2: Search Matches",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestId\": \"{{requestId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/procurement/search",
              "host": ["{{baseUrl}}"],
              "path": ["procurement", "search"]
            }
          }
        },
        {
          "name": "Step 3: Optimize Knapsack DP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestId\": \"{{requestId}}\",\n  \"strategy\": \"balanced\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/procurement/optimize",
              "host": ["{{baseUrl}}"],
              "path": ["procurement", "optimize"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Orders & Approvals",
      "item": [
        {
          "name": "Create Purchase Order Draft",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data && res.data.order && res.data.order.id) {",
                  "    pm.collectionVariables.set('orderId', res.data.order.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestId\": \"{{requestId}}\",\n  \"strategy\": \"balanced\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            }
          }
        },
        {
          "name": "Get Order Details",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}"]
            }
          }
        },
        {
          "name": "Owner Approves Order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/approve",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}", "approve"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Payments",
      "item": [
        {
          "name": "Create PayPal Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data && res.data.paypalOrderId) {",
                  "    pm.collectionVariables.set('paypalOrderId', res.data.paypalOrderId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payments/create",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "create"]
            }
          }
        },
        {
          "name": "Capture PayPal Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paypalOrderId\": \"{{paypalOrderId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payments/capture",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "capture"]
            }
          }
        }
      ]
    },
    {
      "name": "6. Analytics",
      "item": [
        {
          "name": "Get Summary Analytics",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/analytics/summary",
              "host": ["{{baseUrl}}"],
              "path": ["analytics", "summary"]
            }
          }
        }
      ]
    }
  ]
}
